    "typecheck": "tsc --noEmit",
    "test:db": "tsc -p tsconfig.test.json && node dist_test/database/DatabaseTestRunner.js",
    "test:supabase": "tsc -p tsconfig.test.json && node dist_test/services/SupabaseTestRunner.js",
    "test:phase4": "tsc -p tsconfig.test.json && node dist_test/services/Phase4TestRunner.js",
    "test:phase5": "tsc -p tsconfig.test.json && node dist_test/services/Phase5TestRunner.js",
    "test:phase6": "tsc -p tsconfig.test.json && node dist_test/services/Phase6TestRunner.js",
    "test:phase7": "tsc -p tsconfig.test.json && node dist_test/services/Phase7TestRunner.js",
    "test:branding": "node dist_test/services/Phase7BrandingTestRunner.js",
    "test:pqc": "node dist_test/services/PqcTestRunner.js",
    "test:phase8": "node dist_test/services/Phase8TestRunner.js",
    "test:step1": "tsc -p tsconfig.test.json && node dist_test/services/Step1GuardianCircleTestRunner.js",
    "test:all": "tsc -p tsconfig.test.json && node dist_test/database/DatabaseTestRunner.js && node dist_test/services/SupabaseTestRunner.js && node dist_test/services/Phase4TestRunner.js && node dist_test/services/Phase5TestRunner.js && node dist_test/services/Phase6TestRunner.js && node dist_test/services/Phase7TestRunner.js && node dist_test/services/Phase7BrandingTestRunner.js && node dist_test/services/PqcTestRunner.js && node dist_test/services/Phase8TestRunner.js && node dist_test/services/Step1GuardianCircleTestRunner.js"
