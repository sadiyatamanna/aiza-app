    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@supabase/supabase-js": "^2.49.1",
    "react": "18.3.1",
    "react-native": "0.76.7",
    "react-native-maps": "^1.29.2",
